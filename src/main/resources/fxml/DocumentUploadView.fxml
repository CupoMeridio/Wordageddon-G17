<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="schermataDocumentiAdmin" fitToHeight="true" fitToWidth="true" stylesheets="@../styles/appview.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.diem.wordageddong17.controller.DocumentUploadController">
    <VBox alignment="CENTER" maxWidth="Infinity" spacing="25.0" style="-fx-padding: 40;">
        <children>
            <Label alignment="CENTER" style="-fx-font-size: 32px; -fx-font-weight: bold;" text="Inserisci documenti" />
            
            <VBox alignment="CENTER" maxWidth="Infinity" spacing="25">
                <children>
                    <HBox alignment="CENTER" maxWidth="Infinity" spacing="20">
                        <children>
                            <Label text="Nome documento:" />
                            <TextField fx:id="pathTextField" minHeight="35" prefWidth="350" promptText="NomeFile.txt" HBox.hgrow="ALWAYS" />
                        </children>
                    </HBox>
                    
                    <VBox alignment="CENTER" maxWidth="Infinity" spacing="15">
                        <children>
                            <Label text="Scegli lingua:" />
                            <HBox alignment="CENTER" maxWidth="Infinity" spacing="20">
                                <children>
                                    <RadioButton fx:id="adminRadioIT" mnemonicParsing="false" text="IT">
                                        <toggleGroup>
                                            <ToggleGroup fx:id="lingua" />
                                        </toggleGroup>
                                    </RadioButton>
                                    <RadioButton fx:id="adminRadioEN" mnemonicParsing="false" text="EN" toggleGroup="$lingua" />
                                    <RadioButton fx:id="adminRadioES" mnemonicParsing="false" text="ES" toggleGroup="$lingua" />
                                    <RadioButton fx:id="adminRadioDE" mnemonicParsing="false" text="DE" toggleGroup="$lingua" />
                                    <RadioButton fx:id="adminRadioFR" mnemonicParsing="false" text="FR" toggleGroup="$lingua" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                    
                    <VBox alignment="CENTER" maxWidth="Infinity" spacing="15">
                        <children>
                            <Label text="Scegli la difficoltà:" />
                            <HBox alignment="CENTER" maxWidth="Infinity" spacing="20">
                                <children>
                                    <RadioButton fx:id="adminRadioFacile" mnemonicParsing="false" text="Facile">
                                        <toggleGroup>
                                            <ToggleGroup fx:id="inserisciDifficolta" />
                                        </toggleGroup>
                                    </RadioButton>
                                    <RadioButton fx:id="adminRadioMedio" mnemonicParsing="false" text="Medio" toggleGroup="$inserisciDifficolta" />
                                    <RadioButton fx:id="adminRadioDifficile" mnemonicParsing="false" text="Difficile" toggleGroup="$inserisciDifficolta" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                    
                    <Button fx:id="browseButton" mnemonicParsing="false" onAction="#scegliFileTesto" prefHeight="45" prefWidth="250" text="Scegli file di testo" />
                    
                    <HBox alignment="CENTER" maxWidth="Infinity" spacing="25">
                        <children>
                            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#caricaTesto" prefHeight="45" prefWidth="220" text="Salva documento" />
                            <Button fx:id="backToGestDoc" mnemonicParsing="false" onAction="#backToGestDoc" prefHeight="45" prefWidth="180" text="Indietro" />
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </VBox>
</ScrollPane>
