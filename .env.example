# =============================================================================
# Wordageddon - Configurazione Database
# =============================================================================
# Copiare questo file in .env per configurare la connessione al database locale o remoto:
#   cp .env.example .env
#
# Se queste variabili non sono definite, l'applicazione usa automaticamente
# i parametri di default allineati a docker-compose.yml:
#   jdbc:postgresql://localhost:5432/wordageddon (utente: wordageddon, password: wordageddon)
# =============================================================================

DB_URL=jdbc:postgresql://localhost:5432/wordageddon
DB_USER=wordageddon
DB_PASSWORD=wordageddon
