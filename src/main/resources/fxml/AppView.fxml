<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainContainer" maxHeight="Infinity" maxWidth="Infinity" prefHeight="700.0" prefWidth="1000.0" stylesheets="@../styles/appview.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.diem.wordageddong17.controller.AppViewController">
    <center>
        <StackPane fx:id="contentArea" alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity">
            <children>
                <!-- Area in cui NavigationService carica dinamicamente le viste -->
                <StackPane fx:id="viewContainer" alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity" />

                <!-- Loading Overlay globale -->
                <AnchorPane fx:id="loadingOverlay" mouseTransparent="false" style="-fx-background-color: rgba(0, 0, 0, 0.7);" visible="false" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" StackPane.alignment="CENTER">
                    <children>
                        <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <children>
                                <ProgressIndicator style="-fx-progress-color: white;" />
                                <Label style="-fx-text-fill: white;" text="Caricamento in corso...">
                                    <font>
                                        <Font size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </children>
        </StackPane>
    </center>
</BorderPane>
