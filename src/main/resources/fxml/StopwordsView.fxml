<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="schermataStopwords" fitToHeight="true" fitToWidth="true" stylesheets="@../styles/appview.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.diem.wordageddong17.controller.StopwordsController">
    <VBox alignment="CENTER" maxWidth="Infinity" spacing="30.0" style="-fx-padding: 40;">
        <children>
            <Label style="-fx-font-size: 32px; -fx-font-weight: bold;" text="Modifica le stopwords" />
            
            <TextArea fx:id="stopwordTextArea" maxWidth="Infinity" prefHeight="380.0" prefWidth="750.0" VBox.vgrow="ALWAYS" />
            
            <HBox alignment="CENTER" maxWidth="Infinity" spacing="30">
                <children>
                    <Button fx:id="tornaHomeButton" mnemonicParsing="false" onAction="#tornaAllaHome" prefHeight="45" prefWidth="320" text="Torna alla Homepage" />
                    <Button fx:id="salvaStopwordsButton" mnemonicParsing="false" onAction="#salvaStopwords" prefHeight="45" prefWidth="220" text="Salva" />
                </children>
            </HBox>
        </children>
    </VBox>
</ScrollPane>
