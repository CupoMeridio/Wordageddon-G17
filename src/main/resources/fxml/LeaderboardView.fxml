<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="schermataClassifiche" alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity" spacing="20.0" style="-fx-padding: 30;" stylesheets="@../styles/appview.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.diem.wordageddong17.controller.LeaderboardController">
    <children>
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Classifiche globali" />
        
        <HBox alignment="CENTER" maxWidth="Infinity" spacing="30.0">
            <children>
                <!-- Facile -->
                <VBox alignment="TOP_CENTER" spacing="15" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Facile" />
                        <TableView fx:id="facileTable" prefHeight="400" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="facilePosizione" editable="false" prefWidth="70.0" sortable="false" text="Posizione" />
                                <TableColumn fx:id="facileNome" editable="false" prefWidth="180.0" sortable="false" text="Nome" />
                                <TableColumn fx:id="facilePunteggio" editable="false" prefWidth="100.0" sortable="false" text="Punteggio" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <!-- Media -->
                <VBox alignment="TOP_CENTER" spacing="15" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Media" />
                        <TableView fx:id="mediaTable" prefHeight="400" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="mediaPosizione" editable="false" prefWidth="70.0" sortable="false" text="Posizione" />
                                <TableColumn fx:id="mediaNome" editable="false" prefWidth="180.0" sortable="false" text="Nome" />
                                <TableColumn fx:id="mediaPunteggio" editable="false" prefWidth="100.0" sortable="false" text="Punteggio" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <!-- Difficile -->
                <VBox alignment="TOP_CENTER" spacing="15" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Difficile" />
                        <TableView fx:id="difficileTable" prefHeight="400" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="difficilePosizione" editable="false" prefWidth="70.0" sortable="false" text="Posizione" />
                                <TableColumn fx:id="difficileNome" editable="false" prefWidth="180.0" sortable="false" text="Nome" />
                                <TableColumn fx:id="difficilePunteggio" editable="false" prefWidth="100.0" sortable="false" text="Punteggio" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>
        
        <Button fx:id="chiudiClassificheButton" onAction="#chiudiClassificheOnAction" prefHeight="45" prefWidth="250" text="Chiudi classifiche" />
    </children>
</VBox>
